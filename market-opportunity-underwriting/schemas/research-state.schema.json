{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlane66/opportunity-underwriting-for-agents-and-humans/market-opportunity-underwriting/schemas/research-state.schema.json",
  "title": "Market Opportunity Underwriting Research State",
  "type": "object",
  "required": [
    "schema_version", "phase", "status", "decision_context", "context_profile", "scrutiny_profile",
    "decision_hurdle", "market_definition", "cruxes", "research_queue", "fatal_gates", "gap", "demand",
    "sizing", "reachability", "conditional_modules", "falsification", "evidence_burden", "verdict",
    "next_test", "notes"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "phase": {"enum": ["CLASSIFY", "CRUXES", "FATAL_GATES", "ESTABLISH_MARKET", "SIZE", "CONDITIONAL_UNDERWRITING", "FALSIFY", "SYNTHESIZE", "COMPLETE"]},
    "status": {"enum": ["ACTIVE", "BLOCKED", "COMPLETE"]},
    "decision_context": {"enum": ["napkin-stage", "prototype-pre-revenue", "early-revenue", "growth-stage", "corporate-market-entry", "investor-acquisition", "other"]},
    "context_profile": {
      "type": "object",
      "required": ["evidence_emphasis", "primary_question"],
      "properties": {
        "evidence_emphasis": {"type": "string", "minLength": 1},
        "primary_question": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scrutiny_profile": {
      "type": "object",
      "required": ["name", "focus", "adjacent_diligence"],
      "properties": {
        "name": {"enum": ["general", "venture-seed", "venture-early", "venture-growth", "growth-equity", "pe-commercial-diligence", "corporate"]},
        "focus": {"type": "string", "minLength": 1},
        "adjacent_diligence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "decision_hurdle": {
      "type": "object",
      "required": ["status", "required_outcome", "time_horizon_years", "capital_at_risk", "notes"],
      "properties": {
        "status": {"enum": ["PROVISIONAL", "DEFINED"]},
        "required_outcome": {"type": "string", "minLength": 1},
        "time_horizon_years": {"type": "integer", "minimum": 1, "maximum": 20},
        "capital_at_risk": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "market_definition": {
      "type": "object",
      "required": [
        "status", "target_user", "economic_buyer", "problem_job", "geography", "unit_of_demand",
        "revenue_model", "category_creation", "included", "excluded", "candidate_definitions",
        "selected_definition_id", "selection_rationale", "robustness_across_definitions", "robustness_notes"
      ],
      "properties": {
        "status": {"enum": ["UNSET", "PROVISIONAL", "DEFINED"]},
        "target_user": {"type": "string"},
        "economic_buyer": {"type": "string"},
        "problem_job": {"type": "string"},
        "geography": {"type": "string"},
        "unit_of_demand": {"type": "string"},
        "revenue_model": {"type": "string"},
        "category_creation": {"type": "boolean"},
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}},
        "candidate_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "boundary", "rationale", "status"],
            "properties": {
              "id": {"type": "string", "pattern": "^MD[0-9]{2,}$"},
              "label": {"type": "string", "minLength": 1},
              "boundary": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "status": {"enum": ["CANDIDATE", "SELECTED", "REJECTED"]}
            },
            "additionalProperties": false
          }
        },
        "selected_definition_id": {"type": ["string", "null"]},
        "selection_rationale": {"type": "string"},
        "robustness_across_definitions": {"enum": ["UNASSESSED", "ROBUST", "SENSITIVE", "NOT_APPLICABLE"]},
        "robustness_notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "cruxes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "claim", "importance", "support_status", "evidence_ids", "cheapest_test"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
          "claim": {"type": "string", "minLength": 1},
          "importance": {"enum": ["FATAL", "HIGH", "MEDIUM"]},
          "support_status": {"enum": ["UNTESTED", "SUPPORTED", "WEAK", "REFUTED", "NOT_KNOWABLE_FROM_DESK_RESEARCH"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "cheapest_test": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "research_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "crux_id", "question", "decision_impact", "uncertainty", "expected_decision_change", "evidence_tractability", "cost_time", "proposed_evidence", "status", "search_plan_ids", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^RQ[0-9]{3,}$"},
          "crux_id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
          "question": {"type": "string", "minLength": 1},
          "decision_impact": {"enum": ["FATAL", "HIGH", "MEDIUM", "LOW"]},
          "uncertainty": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "expected_decision_change": {"enum": ["YES", "UNCLEAR", "NO"]},
          "evidence_tractability": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "cost_time": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "proposed_evidence": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "DEFERRED"]},
          "search_plan_ids": {"type": "array", "items": {"type": "string", "pattern": "^SP[0-9]{3,}$"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "fatal_gates": {"type": "array", "items": {"type": "object"}},
    "gap": {"type": "object"},
    "demand": {
      "type": "object",
      "required": ["status", "highest_tier", "economic_demand_demonstrated", "dimensions", "evidence_ids", "reasoning"],
      "properties": {
        "status": {"enum": ["UNASSESSED", "DEMONSTRATED", "PARTIAL", "NOT_DEMONSTRATED", "UNCLEAR"]},
        "highest_tier": {"enum": ["A", "B", "C", "D", "E", "F", null]},
        "economic_demand_demonstrated": {"type": "boolean"},
        "dimensions": {
          "type": "object",
          "required": ["problem_economic_burden", "budget_availability", "solution_wtp", "behavioral_adoption"],
          "additionalProperties": {
            "type": "object",
            "required": ["status", "evidence_ids", "reasoning"],
            "properties": {
              "status": {"enum": ["STRONG", "MODERATE", "WEAK", "UNKNOWN", "NOT_APPLICABLE"]},
              "evidence_ids": {"type": "array", "items": {"type": "string"}},
              "reasoning": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "reasoning": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sizing": {"type": "object"},
    "reachability": {"type": "object"},
    "conditional_modules": {"type": "object"},
    "falsification": {
      "type": "object",
      "required": ["status", "queries", "evidence_ids", "contradictions", "coverage"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "IN_PROGRESS", "COMPLETE"]},
        "queries": {"type": "array", "items": {"type": "object"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["crux_id", "adversarial_search_ids", "strongest_for", "strongest_against", "rival_explanation", "adjudication", "status_changed"],
            "properties": {
              "crux_id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
              "adversarial_search_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{3,}$"}},
              "strongest_for": {"type": "string"},
              "strongest_against": {"type": "string"},
              "rival_explanation": {"type": "string"},
              "adjudication": {"type": "string", "minLength": 1},
              "status_changed": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_burden": {
      "type": "object",
      "required": ["load_bearing_count", "assumption_count", "not_knowable_count", "fatal_gate_assumption"],
      "properties": {
        "load_bearing_count": {"type": "integer", "minimum": 0},
        "assumption_count": {"type": "integer", "minimum": 0},
        "not_knowable_count": {"type": "integer", "minimum": 0},
        "fatal_gate_assumption": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "required": ["status", "recommendation", "summary", "confidence"],
      "properties": {
        "status": {"enum": ["UNSET", "DRAFT", "FINAL"]},
        "recommendation": {"enum": ["PURSUE", "TEST", "HOLD", "REJECT", null]},
        "summary": {"type": "string"},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", null]}
      },
      "additionalProperties": false
    },
    "next_test": {
      "type": "object",
      "required": ["status", "variable_id", "test", "decision_value", "estimated_cost_time"],
      "properties": {
        "status": {"enum": ["UNSET", "DEFINED", "NOT_NEEDED"]},
        "variable_id": {"type": ["string", "null"]},
        "test": {"type": "string"},
        "decision_value": {"type": "string"},
        "estimated_cost_time": {"type": "string"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
