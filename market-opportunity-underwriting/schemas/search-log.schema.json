{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlane66/opportunity-underwriting-for-agents-and-humans/market-opportunity-underwriting/schemas/search-log.schema.json",
  "title": "Market Opportunity Search Log",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "search_plan_id", "crux_id", "query", "searched_at", "route", "polarity", "source_class", "results_screened", "evidence_ids", "refinement_reason", "stop_reason", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{3,}$"},
          "search_plan_id": {"type": "string", "pattern": "^SP[0-9]{3,}$"},
          "crux_id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
          "query": {"type": "string", "minLength": 1},
          "searched_at": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "polarity": {"enum": ["CONFIRMATORY", "ADVERSARIAL", "NEUTRAL"]},
          "source_class": {"type": "string", "minLength": 1},
          "results_screened": {"type": ["integer", "null"], "minimum": 0},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}},
          "refinement_reason": {"type": "string"},
          "stop_reason": {"type": "string"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
