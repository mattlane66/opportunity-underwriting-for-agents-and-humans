{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlane66/opportunity-underwriting-for-agents-and-humans/market-opportunity-underwriting/schemas/evidence-ledger.schema.json",
  "title": "Market Opportunity Evidence Ledger",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim_input", "epistemic_state", "confidence", "load_bearing", "used_by", "contradictions", "validation_next_step"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
          "claim_input": {"type": "string", "minLength": 1},
          "value": {},
          "low": {"type": ["number", "null"]},
          "high": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]},
          "epistemic_state": {"enum": ["OBSERVED", "ESTIMATED", "BOUNDED", "ASSUMPTION", "NOT_KNOWABLE_FROM_DESK_RESEARCH"]},
          "source": {"type": ["string", "null"]},
          "source_date": {"type": ["string", "null"]},
          "source_type": {"type": ["string", "null"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "NOT_APPLICABLE"]},
          "load_bearing": {"type": "boolean"},
          "fatal_gate_related": {"type": "boolean"},
          "used_by": {"type": "array", "items": {"type": "string"}},
          "contradictions": {"type": "array", "items": {"type": "string"}},
          "validation_next_step": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
